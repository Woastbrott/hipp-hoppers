# ---------------------------------------------------------------------------
# Laufzeit-Umgebung auf dem Server.
#
# Auf dem Server als /opt/hipp-hoppers/.env anlegen und ausfuellen. Diese Datei
# wird vom Deploy-Script bewusst NICHT uebertragen — Secrets reisen nicht mit.
# ---------------------------------------------------------------------------

# Der Name, unter dem die Seite erreichbar ist. Caddy holt dafuer das Zertifikat.
# Ohne eigene Domain tut es ein nip.io-Name auf die Server-IP.
DOMAIN="179.198.197.248.nip.io"

# Muss zur DOMAIN passen: daran haengt der CSRF-Origin-Check.
APP_ORIGIN="https://179.198.197.248.nip.io"

# Neon, gepoolter Endpunkt.
DATABASE_URL="postgresql://user:password@ep-beispiel.eu-central-1.aws.neon.tech/hipphoppers?sslmode=require"

# Frisch erzeugen, nicht den aus der lokalen Entwicklung uebernehmen:
#   openssl rand -base64 48
JWT_SECRET=""

# Vercel-Dashboard -> Storage -> Blob -> Read/Write Token.
BLOB_READ_WRITE_TOKEN=""

NODE_ENV="production"
