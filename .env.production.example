# ---------------------------------------------------------------------------
# Referenzliste der Laufzeit-Variablen für den Serverbetrieb.
#
# Diese Werte werden NICHT als Datei ausgeliefert. Sie gehören in die Coolify-UI
# (Application → Environment Variables) — nie ins Repo, nie in einen Befehl inline.
#
# Diese Datei existiert nur, damit nachvollziehbar bleibt, welche Schlüssel gesetzt
# sein müssen und was sie bedeuten.
# ---------------------------------------------------------------------------

# Postgres im internen Docker-Netz. Coolify hinterlegt den Namen des DB-Containers
# als Host; der Port bleibt der Standard.
#   postgresql://<user>:<passwort>@<db-container>:5432/<datenbank>
DATABASE_URL=

# Signiert das Session-JWT (HS256), mindestens 32 Zeichen.
# Frisch erzeugen, nicht den aus der lokalen Entwicklung übernehmen:
#   openssl rand -base64 48
JWT_SECRET=

# Die Origin, unter der die Seite läuft — daran hängt der CSRF-Check.
# Muss zur Domain passen, die in Coolify für die Anwendung gesetzt ist.
#   https://beispiel.de
APP_ORIGIN=

# Vercel Blob Store für die Bilder. Mindestens 20 Zeichen, sonst startet die
# Anwendung nicht. Ohne gültigen Token laufen alle anderen Funktionen normal —
# nur der Bild-Upload schlägt fehl.
BLOB_READ_WRITE_TOKEN=

NODE_ENV=production
