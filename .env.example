# ---------------------------------------------------------------------------
# Hipp Hoppers — Environment
# Kopie anlegen als `.env.local` (wird von git ignoriert) und Werte einsetzen.
# Alle Variablen sind server-only. Kein NEXT_PUBLIC_-Prefix, nirgends.
# ---------------------------------------------------------------------------

# --- Datenbank (Neon, serverless Postgres) ---
# Connection-String aus dem Neon-Dashboard, gepoolter Endpunkt.
DATABASE_URL="postgresql://user:password@ep-beispiel-123456.eu-central-1.aws.neon.tech/hipphoppers?sslmode=require"

# --- Auth ---
# Signiert das Session-JWT (HS256). Mindestens 32 Zeichen.
# Erzeugen: openssl rand -base64 48
JWT_SECRET="bitte-ersetzen-mindestens-32-zeichen-lang-xxxxxxxx"

# Erlaubte Origin fuer den CSRF-Check, z. B. "https://hipp-hoppers.de".
# Leer lassen: dann wird die Origin gegen den (Forwarded-)Host der Anfrage geprueft.
APP_ORIGIN=""

# --- Seed (nur fuer `pnpm db:seed`, zur Laufzeit nicht noetig) ---
SEED_ADMIN_EMAIL="admin@hipp-hoppers.de"
SEED_ADMIN_PASSWORD="bitte-ein-langes-passwort-setzen"

# --- Bilder: Vercel Blob ---
# Vercel-Dashboard -> Storage -> Blob -> Store anlegen -> "Read/Write Token".
# Pflicht: ohne ihn kann die Upload-Route keine Client-Token ausstellen.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_beispiel_bitte-ersetzen"
