# Terminiert TLS und reicht an den Next-Container weiter.
#
# Die Adresse kommt aus DOMAIN in der .env. Caddy holt dafuer automatisch ein
# Let's-Encrypt-Zertifikat — das geht nur mit einem Namen, nicht mit einer nackten
# IP. Ohne eigene Domain funktioniert z. B. 179.198.197.248.nip.io.
#
# Ohne TLS koenntest du dich nicht anmelden: das Session-Cookie ist in Produktion
# `Secure`, und das verwirft der Browser ueber einfaches HTTP.
{$DOMAIN} {
	encode zstd gzip

	# Caddy setzt X-Forwarded-For, -Proto und -Host selbst. Genau die liest die App
	# fuer den CSRF-Origin-Check und den IP-Bucket des Rate-Limiters.
	reverse_proxy app:3000

	log {
		output stdout
		format console
	}
}
